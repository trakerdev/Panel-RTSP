[Unit]
Description=RTSP Cameras Snapshot Recorder
After=network-online.target local-fs.target
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStart=/home/USUARIO/tareas/capturar_cams.sh
Restart=always
RestartSec=5

# Optimización para bajo consumo y aislamiento en CPUs multinúcleo
Nice=10
CPUAffinity=2,3
CPUQuota=200%

[Install]
WantedBy=multi-user.target
